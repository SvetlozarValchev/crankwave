  "semantic_id": resolved<tstr>
}

cylinder-spec = {
  "id": stable-id,
  "semantic_id": resolved<tstr>,
  "bank_id": stable-id,
  "crankshaft_id": stable-id,
  "intake_id": stable-id,
  "bore_m": resolved<f64-bits>,
  "stroke_m": resolved<f64-bits>,
  "connecting_rod_length_m": resolved<f64-bits>,
  "compression_ratio": resolved<f64-bits>,
  "firing_tdc_offset_rad": resolved<f64-bits>,
