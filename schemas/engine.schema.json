{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crankwave.dev/schemas/engine.schema.json",
  "title": "Crankwave engine package document",
  "$comment": "This is the single current authoring schema. Schema-valid capabilities may still be rejected by the compiler when their executable implementation is not available.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "engine", "presentation"],
  "properties": {
    "schema": { "const": "crankwave/engine" },
    "engine": { "$ref": "#/$defs/engine" },
    "presentation": { "$ref": "#/$defs/presentation" },
    "rig": {
      "anyOf": [
        { "$ref": "#/$defs/rig" },
        { "type": "null" }
      ]
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "minLength": 1, "maxLength": 32 },
        "standard": {
          "enum": [null, "carburetor_1p5_inhg", "port_28_inh2o"]
        }
      }
    },
    "nonnegativePressureQuantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "unit": {
          "enum": ["Pa", "kPa", "bar", "atm", "psi", "inHg", "inH2O"]
        }
      }
    },
    "nonnegativePressurePerSpeedQuantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "unit": { "enum": ["Pa*s/m", "kPa*s/m", "bar*s/m"] }
      }
    },
    "nonnegativePressurePerSpeedSquaredQuantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "unit": { "enum": ["Pa*s2/m2", "kPa*s2/m2", "bar*s2/m2"] }
      }
    },
    "positiveFrequencyQuantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "enum": ["Hz", "kHz"] }
      }
    },
    "fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "flowBenchRatedFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "standard"],
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "unit": { "type": "string", "minLength": 1, "maxLength": 32 },
        "standard": {
          "enum": ["carburetor_1p5_inhg", "port_28_inh2o"]
        }
      }
    },
    "nonnegative": {
      "type": "number",
      "minimum": 0
    },
    "dimension": {
      "enum": [
        "dimensionless",
        "angle",
        "angular_speed",
        "area",
        "density",
        "duration",
        "energy_per_mass",
        "force",
        "frequency",
        "length",
        "mass",
        "mass_flow_rate",
        "molar_mass",
        "moment_of_inertia",
        "power",
        "pressure",
        "pressure_per_speed",
        "pressure_per_speed_squared",
        "speed",
        "temperature",
        "torque",
        "volume",
        "volume_flow_rate"
      ]
    },
    "curveSample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output"],
      "properties": {
        "input": { "$ref": "#/$defs/quantity" },
        "output": { "$ref": "#/$defs/quantity" }
      }
    },
    "curve": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "input_dimension",
        "output_dimension",
        "evaluation",
        "below_domain",
        "above_domain",
        "samples"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "input_dimension": { "$ref": "#/$defs/dimension" },
        "output_dimension": { "$ref": "#/$defs/dimension" },
        "evaluation": {
          "enum": ["linear", "right_continuous_hold", "triangle_weighted_samples"]
        },
        "triangle_filter_radius": {
          "anyOf": [
            { "$ref": "#/$defs/quantity" },
            { "type": "null" }
          ]
        },
        "below_domain": { "enum": ["clamp", "zero", "reject"] },
        "above_domain": { "enum": ["clamp", "zero", "reject"] },
        "samples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/curveSample" }
        }
      }
    },
    "flowBenchRestriction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "rated_flow", "pressure_drop"],
      "properties": {
        "type": { "const": "flow_bench" },
        "rated_flow": { "$ref": "#/$defs/flowBenchRatedFlow" },
        "pressure_drop": { "$ref": "#/$defs/quantity" }
      }
    },
    "orificeRestriction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "effective_area", "discharge_coefficient_01"],
      "properties": {
        "type": { "const": "orifice" },
        "effective_area": { "$ref": "#/$defs/quantity" },
        "discharge_coefficient_01": { "$ref": "#/$defs/fraction" }
      }
    },
    "curveRestriction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "pressure_drop_to_flow"],
      "properties": {
        "type": { "const": "curve" },
        "pressure_drop_to_flow": { "$ref": "#/$defs/id" }
      }
    },
    "flowRestriction": {
      "oneOf": [
        { "$ref": "#/$defs/flowBenchRestriction" },
        { "$ref": "#/$defs/orificeRestriction" },
        { "$ref": "#/$defs/curveRestriction" }
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "description": { "type": ["string", "null"], "maxLength": 4096 }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["redline"],
      "properties": {
        "redline": { "$ref": "#/$defs/quantity" }
      }
    },
    "crankshaft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "throw_radius",
        "mass",
        "flywheel_mass",
        "moment_of_inertia",
        "friction_torque",
        "tdc_reference_angle"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "throw_radius": { "$ref": "#/$defs/quantity" },
        "mass": { "$ref": "#/$defs/quantity" },
        "flywheel_mass": { "$ref": "#/$defs/quantity" },
        "moment_of_inertia": { "$ref": "#/$defs/quantity" },
        "friction_torque": { "$ref": "#/$defs/quantity" },
        "tdc_reference_angle": { "$ref": "#/$defs/quantity" }
      }
    },
    "crankshaftJournal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "crankshaft", "phase"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "crankshaft" },
        "crankshaft": { "$ref": "#/$defs/id" },
        "phase": { "$ref": "#/$defs/quantity" }
      }
    },
    "masterRodJournal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "master_cylinder", "throw_radius", "phase"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "master_rod" },
        "master_cylinder": { "$ref": "#/$defs/id" },
        "throw_radius": { "$ref": "#/$defs/quantity" },
        "phase": { "$ref": "#/$defs/quantity" }
      }
    },
    "journal": {
      "oneOf": [
        { "$ref": "#/$defs/crankshaftJournal" },
        { "$ref": "#/$defs/masterRodJournal" }
      ]
    },
    "connectingRod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "length",
        "mass",
        "moment_of_inertia"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "length": { "$ref": "#/$defs/quantity" },
        "mass": { "$ref": "#/$defs/quantity" },
        "moment_of_inertia": { "$ref": "#/$defs/quantity" },
        "center_of_mass_from_crank_pin": {
          "description": "Physical distance from the crank-pin center to the rod center of mass along the connecting rod. When omitted, it resolves to half the authored rod length.",
          "anyOf": [
            { "$ref": "#/$defs/quantity" },
            { "type": "null" }
          ]
        }
      }
    },
    "piston": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mass",
        "compression_height",
        "displacement_volume"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "mass": { "$ref": "#/$defs/quantity" },
        "compression_height": { "$ref": "#/$defs/quantity" },
        "wrist_pin_position": {
          "description": "Nonnegative axial offset that places the piston reference point outward from the wrist-pin center. When omitted, it resolves to zero.",
          "anyOf": [
            { "$ref": "#/$defs/quantity" },
            { "type": "null" }
          ]
        },
        "displacement_volume": { "$ref": "#/$defs/quantity" },
        "blowby": {
          "anyOf": [
            { "$ref": "#/$defs/flowRestriction" },
            { "type": "null" }
          ]
        }
      }
    },
    "bank": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "angle", "bore", "deck_height", "head"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "angle": { "$ref": "#/$defs/quantity" },
        "bore": { "$ref": "#/$defs/quantity" },
        "deck_height": { "$ref": "#/$defs/quantity" },
        "head": { "$ref": "#/$defs/id" }
      }
    },
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "plenum_volume",
        "plenum_cross_section_area",
        "runner_length",
        "main_restriction",
        "idle_bypass_restriction",
        "runner_restriction",
        "idle_throttle_position_01",
        "runner_velocity_decay_01",
        "main_mixture_lambda"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "plenum_volume": { "$ref": "#/$defs/quantity" },
        "plenum_cross_section_area": { "$ref": "#/$defs/quantity" },
        "runner_length": { "$ref": "#/$defs/quantity" },
        "main_restriction": { "$ref": "#/$defs/flowRestriction" },
        "idle_bypass_restriction": { "$ref": "#/$defs/flowRestriction" },
        "runner_restriction": { "$ref": "#/$defs/flowRestriction" },
        "idle_throttle_position_01": { "$ref": "#/$defs/fraction" },
        "runner_velocity_decay_01": { "$ref": "#/$defs/fraction" },
        "main_mixture_lambda": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "exhaust": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": ["collector_length"],
          "properties": {
            "collector_length": { "$ref": "#/$defs/quantity" }
          }
        },
        {
          "required": ["collector_volume"],
          "properties": {
            "collector_volume": { "$ref": "#/$defs/quantity" }
          }
        }
      ],
      "required": [
        "id",
        "collector_cross_section_area",
        "primary_tube_length",
        "outlet_restriction",
        "primary_restriction",
        "velocity_decay_01"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "collector_cross_section_area": { "$ref": "#/$defs/quantity" },
        "collector_length": {
          "anyOf": [
            { "$ref": "#/$defs/quantity" },
            { "type": "null" }
          ]
        },
        "collector_volume": {
          "anyOf": [
            { "$ref": "#/$defs/quantity" },
            { "type": "null" }
          ]
        },
        "primary_tube_length": { "$ref": "#/$defs/quantity" },
        "outlet_restriction": { "$ref": "#/$defs/flowRestriction" },
        "primary_restriction": { "$ref": "#/$defs/flowRestriction" },
        "velocity_decay_01": { "$ref": "#/$defs/fraction" }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "head",
        "kind",
        "runner_volume",
        "runner_cross_section_area",
        "flow_curve"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "head": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["intake", "exhaust"] },
        "runner_volume": { "$ref": "#/$defs/quantity" },
        "runner_cross_section_area": { "$ref": "#/$defs/quantity" },
        "flow_curve": { "$ref": "#/$defs/id" }
      }
    },
    "sampledCamLobe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "cylinder",
        "port_kind",
        "centerline",
        "type",
        "lift_curve"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "cylinder": { "$ref": "#/$defs/id" },
        "port_kind": { "enum": ["intake", "exhaust"] },
        "centerline": { "$ref": "#/$defs/quantity" },
        "type": { "const": "sampled" },
        "lift_curve": { "$ref": "#/$defs/id" }
      }
    },
    "harmonicCamLobe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "cylinder",
        "port_kind",
        "centerline",
        "type",
        "duration_at_reference_lift",
        "reference_lift",
        "maximum_lift",
        "gamma",
        "sample_count"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "cylinder": { "$ref": "#/$defs/id" },
        "port_kind": { "enum": ["intake", "exhaust"] },
        "centerline": { "$ref": "#/$defs/quantity" },
        "type": { "const": "harmonic" },
        "duration_at_reference_lift": { "$ref": "#/$defs/quantity" },
        "reference_lift": { "$ref": "#/$defs/quantity" },
        "maximum_lift": { "$ref": "#/$defs/quantity" },
        "gamma": { "type": "number", "minimum": 0 },
        "sample_count": { "type": "integer", "minimum": 2 }
      }
    },
    "camLobe": {
      "oneOf": [
        { "$ref": "#/$defs/sampledCamLobe" },
        { "$ref": "#/$defs/harmonicCamLobe" }
      ]
    },
    "camshaft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "advance", "base_radius", "lobes"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "advance": { "$ref": "#/$defs/quantity" },
        "base_radius": { "$ref": "#/$defs/quantity" },
        "lobes": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "standardValvetrain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "intake_camshaft", "exhaust_camshaft"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "standard" },
        "intake_camshaft": { "$ref": "#/$defs/id" },
        "exhaust_camshaft": { "$ref": "#/$defs/id" }
      }
    },
    "vtecActivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_engine_speed",
        "minimum_manifold_pressure_abs",
        "minimum_throttle_linkage_opening_01"
      ],
      "properties": {
        "minimum_engine_speed": { "$ref": "#/$defs/quantity" },
        "minimum_manifold_pressure_abs": { "$ref": "#/$defs/quantity" },
        "minimum_throttle_linkage_opening_01": {
          "$ref": "#/$defs/fraction"
        }
      }
    },
    "vtecValvetrain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "base_intake_camshaft",
        "base_exhaust_camshaft",
        "alternate_intake_camshaft",
        "alternate_exhaust_camshaft",
        "activation"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "vtec" },
        "base_intake_camshaft": { "$ref": "#/$defs/id" },
        "base_exhaust_camshaft": { "$ref": "#/$defs/id" },
        "alternate_intake_camshaft": { "$ref": "#/$defs/id" },
        "alternate_exhaust_camshaft": { "$ref": "#/$defs/id" },
        "activation": { "$ref": "#/$defs/vtecActivation" }
      }
    },
    "valvetrain": {
      "oneOf": [
        { "$ref": "#/$defs/standardValvetrain" },
        { "$ref": "#/$defs/vtecValvetrain" }
      ]
    },
    "head": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "chamber_volume", "valvetrain", "ports"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "chamber_volume": { "$ref": "#/$defs/quantity" },
        "valvetrain": { "$ref": "#/$defs/id" },
        "ports": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "ignitionWire": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }
      }
    },
    "firingEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wire", "crank_angle"],
      "properties": {
        "wire": { "$ref": "#/$defs/id" },
        "crank_angle": { "$ref": "#/$defs/quantity" }
      }
    },
    "revLimiter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activation_speed", "cut_duration"],
      "properties": {
        "activation_speed": { "$ref": "#/$defs/quantity" },
        "cut_duration": { "$ref": "#/$defs/quantity" }
      }
    },
    "ignition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timing_curve", "wires", "firing_order", "limiter"],
      "properties": {
        "timing_curve": { "$ref": "#/$defs/id" },
        "wires": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ignitionWire" }
        },
        "firing_order": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/firingEvent" }
        },
        "limiter": { "$ref": "#/$defs/revLimiter" }
      }
    },
    "fuel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "molecular_mass",
        "lower_heating_value",
        "stoichiometric_air_fuel_molar_ratio",
        "turbulence_to_flame_speed",
        "combustion"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "molecular_mass": { "$ref": "#/$defs/quantity" },
        "density": {
          "anyOf": [
            { "$ref": "#/$defs/quantity" },
            { "type": "null" }
          ]
        },
        "lower_heating_value": { "$ref": "#/$defs/quantity" },
        "stoichiometric_air_fuel_molar_ratio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "turbulence_to_flame_speed": { "$ref": "#/$defs/id" },
        "combustion": { "$ref": "#/$defs/combustion" }
      }
    },
    "combustion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_efficiency_01",
        "cycle_variation_01",
        "low_efficiency_attenuation_01",
        "maximum_turbulence_effect",
        "maximum_dilution_effect"
      ],
      "properties": {
        "maximum_efficiency_01": { "$ref": "#/$defs/fraction" },
        "cycle_variation_01": { "$ref": "#/$defs/fraction" },
        "low_efficiency_attenuation_01": { "$ref": "#/$defs/fraction" },
        "maximum_turbulence_effect": { "$ref": "#/$defs/nonnegative" },
        "maximum_dilution_effect": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "directThrottleController": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "gamma"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "direct" },
        "gamma": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "governorThrottleController": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "minimum_engine_speed",
        "maximum_engine_speed",
        "minimum_velocity",
        "maximum_velocity",
        "k_s",
        "k_d",
        "gamma"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "governor" },
        "minimum_engine_speed": { "$ref": "#/$defs/quantity" },
        "maximum_engine_speed": { "$ref": "#/$defs/quantity" },
        "minimum_velocity": { "type": "number" },
        "maximum_velocity": { "type": "number" },
        "k_s": { "$ref": "#/$defs/nonnegative" },
        "k_d": { "$ref": "#/$defs/nonnegative" },
        "gamma": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "throttleController": {
      "oneOf": [
        { "$ref": "#/$defs/directThrottleController" },
        { "$ref": "#/$defs/governorThrottleController" }
      ]
    },
    "mechanicallyDisengagedStarter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "mechanically_disengaged" }
      }
    },
    "crankingStarter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "torque", "target_speed"],
      "properties": {
        "type": { "const": "cranking" },
        "torque": { "$ref": "#/$defs/quantity" },
        "target_speed": { "$ref": "#/$defs/quantity" }
      }
    },
    "starter": {
      "oneOf": [
        { "$ref": "#/$defs/mechanicallyDisengagedStarter" },
        { "$ref": "#/$defs/crankingStarter" }
      ]
    },
    "cylinder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
