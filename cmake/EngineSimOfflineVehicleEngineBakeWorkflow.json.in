{
  "schema": "engine-sim-offline/vehicleengine-bake-workflow.v1",
  "release_identity": "@ENGINE_SIM_OFFLINE_RELEASE_IDENTITY@",
  "path_base": "distribution_root",
  "responsive_profile_selection": {
    "default_policy": "engine-redline-affine-v1",
    "profile_id": "interactive-preview-redline-v1",
    "explicit_override": {
      "argument": "--profile",
      "placeholder": "{responsive_profile_json}"
    }
  },
  "telemetry_contract": {
    "producer_command": "render",
    "role": "diagnostics.engine-telemetry.v1",
    "kind": "telemetry",
    "path": "telemetry/engine-telemetry.v1.ndjson",
    "schema": "engine-sim-offline.engine-telemetry.ndjson.v1",
    "originating_commit": "c8d672b59e3046654ad5f818f31725798aef7ffa",
    "included_in_vehicleengine_workflow": false
  },
  "placeholders": {
    "engine_json": "absolute path to the admitted engine document",
    "responsive_profile_json": "optional absolute path for the explicit profile override",
    "new_package_directory": "absolute path that does not exist",
    "cache_directory": "absolute path to the caller-owned reusable cache",
    "worker_count": "decimal integer in [1,32]",
    "deadline_unix_ms": "positive Unix epoch deadline in milliseconds",
    "new_vehicleengine_file": "absolute .vehicleengine path that does not exist"
  },
  "steps": [
    {
      "ordinal": 1,
      "id": "responsive_bake",
      "executable": "@CMAKE_INSTALL_BINDIR@/engine-sim-offline-responsive-bake",
      "arguments": [
        "--engine",
        "{engine_json}",
        "--output",
        "{new_package_directory}",
        "--cache",
        "{cache_directory}",
        "--jobs",
        "{worker_count}",
        "--deadline-unix-ms",
        "{deadline_unix_ms}"
      ],
      "required_output": "{new_package_directory}/vehicleengine.json",
      "required_stdout_record": {
        "schema": "engine-sim-offline/responsive-audio-bake-plan-v1",
        "release_identity": "@ENGINE_SIM_OFFLINE_RELEASE_IDENTITY@",
        "completed": true
      }
    },
    {
      "ordinal": 2,
      "id": "pack",
      "executable": "@CMAKE_INSTALL_BINDIR@/engine-sim-offline",
      "arguments": [
        "pack-vehicleengine",
        "--package-directory",
        "{new_package_directory}",
        "--output",
        "{new_vehicleengine_file}",
        "--deadline-unix-ms",
        "{deadline_unix_ms}",
        "--result-format",
        "json"
      ],
      "required_output": "{new_vehicleengine_file}",
      "required_stdout_record": {
        "schema": "engine-sim-offline.cli-result.v1",
        "release_identity": "@ENGINE_SIM_OFFLINE_RELEASE_IDENTITY@",
        "command": "pack-vehicleengine",
        "ok": true,
        "code": "success",
        "exit_code": 0
      },
      "required_result_fields": {
        "output_file": "{new_vehicleengine_file}"
      }
    },
    {
      "ordinal": 3,
      "id": "verify",
      "executable": "@CMAKE_INSTALL_BINDIR@/engine-sim-offline",
      "arguments": [
        "verify-vehicleengine",
        "--input",
        "{new_vehicleengine_file}",
        "--deadline-unix-ms",
        "{deadline_unix_ms}",
        "--result-format",
        "json"
      ],
      "required_stdout_record": {
        "schema": "engine-sim-offline.cli-result.v1",
        "release_identity": "@ENGINE_SIM_OFFLINE_RELEASE_IDENTITY@",
        "command": "verify-vehicleengine",
        "ok": true,
        "code": "success",
        "exit_code": 0
      },
      "required_result_fields": {
        "verified": true
      }
    }
  ],
  "success": {
    "definition": "all three steps exit zero in ordinal order",
    "publishable_after_step": 3
  }
}
