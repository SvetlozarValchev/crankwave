}

operating-state = {
  "ignition_enabled": bool,
  "fuel_enabled": bool,
  "starter_enabled": bool,
  "dyno_enabled": bool,
  "limiter_enabled": bool
}

render-quality = {
  "profile_id": tstr,
  "version": u32,
  "capture_block_capacity_frames": u32,
  "event_journal_capacity_records": u32
}

scenario-mode =
  {
    "kind": "held_speed",
    "value": held-speed
  } /
  {
    "kind": "prescribed_kinematic_sweep",
    "value": prescribed-kinematic-sweep
  } /
  {
    "kind": "held_dyno",
    "value": held-dyno
  } /
  {
    "kind": "load_target_held_capture",
    "value": load-target-held-capture
  } /
  {
    "kind": "inertial_dyno",
    "value": inertial-dyno
  } /
  {
    "kind": "free_engine",
    "value": free-engine
  } /
  {
    "kind": "free_vehicle",
    "value": free-vehicle
  }

held-speed = {
  "engine_speed_rpm": resolved<f64-bits>,
  "initial_theta_rad": resolved<f64-bits>,
  "throttle_01": resolved<f64-bits>
}

prescribed-kinematic-sweep = {
  "trajectory": rpm-trajectory,
  "throttle_01": scalar-trajectory
}

held-dyno = {
  "initial_engine_speed_rpm": resolved<f64-bits>,
  "initial_theta_rad": resolved<f64-bits>,
  "target_engine_speed_rpm": fixed-rate-rpm-trajectory,
  "throttle_01": scalar-trajectory,
  "maximum_absorbing_torque_nm": resolved<f64-bits>,
  "maximum_driving_torque_nm": resolved<f64-bits>,
  "constraint_method": resolved<method-identity>
}

load-target-held-capture = {
  "engine_speed_rpm": resolved<f64-bits>,
  "initial_theta_rad": resolved<f64-bits>,
  "target_net_bmep_pa": resolved<f64-bits>,
  "target_tolerance_pa": resolved<f64-bits>,
  "throttle_lower_bound_01": resolved<f64-bits>,
  "throttle_upper_bound_01": resolved<f64-bits>,
  "search_method": resolved<method-identity>
}

inertial-dyno = {
  "initial_engine_speed_rpm": resolved<f64-bits>,
  "target_engine_speed_rpm": resolved<f64-bits>,
  "initial_theta_rad": resolved<f64-bits>,
  "equivalent_inertia_kg_m2": resolved<f64-bits>,
  "throttle_01": scalar-trajectory,
  "brake_curve": [* brake-torque-point],
  "brake_curve_resolution_id": tstr,
  "brake_torque_method": resolved<method-identity>,
  "crank_dynamics_method": resolved<method-identity>
}

free-engine = {
  "initial_engine_speed_rpm": resolved<f64-bits>,
  "initial_theta_rad": resolved<f64-bits>,
  "engine_baseline_inertia_kg_m2": resolved<f64-bits>,
  "attached_inertia_kg_m2": resolved<f64-bits>,
  "total_equivalent_inertia_kg_m2": resolved<f64-bits>,
  "throttle_01": scalar-trajectory,
  "external_resisting_torque_nm": scalar-trajectory,
  "crank_dynamics_method": resolved<method-identity>
}

free-vehicle = {
  "initial_engine_speed_rpm": resolved<f64-bits>,
  "initial_theta_rad": resolved<f64-bits>,
  "engine_baseline_inertia_kg_m2": resolved<f64-bits>,
  "initial_vehicle_speed_m_s": resolved<f64-bits>,
  "rig": free-vehicle-rig,
  "throttle_01": scalar-trajectory,
  "selected_gear": resolved<gear-selection-point-array>,
  "clutch_engagement_01": resolved<scalar-control-point-array>,
  "service_brake_application_01": resolved<scalar-control-point-array>,
  "crank_dynamics_method": resolved<method-identity>,
  "road_load_method": resolved<method-identity>,
  "clutch_coupling_method": resolved<method-identity>,
  "drivetrain_dynamics_method": resolved<method-identity>
}

free-vehicle-rig = {
  "id": stable-id,
  "semantic_id": resolved<tstr>,
  "vehicle": forward-vehicle-spec,
  "transmission": forward-transmission-spec
}

forward-vehicle-spec = {
  "id": stable-id,
  "semantic_id": resolved<tstr>,
  "mass_kg": resolved<f64-bits>,
  "drag_coefficient": resolved<f64-bits>,
  "frontal_area_m2": resolved<f64-bits>,
  "differential_ratio": resolved<f64-bits>,
  "tire_radius_m": resolved<f64-bits>,
  "rolling_resistance_force_n": resolved<f64-bits>,
  "maximum_service_brake_force_n": resolved<f64-bits> / null
}

forward-transmission-spec = {
  "id": stable-id,
  "semantic_id": resolved<tstr>,
  "maximum_clutch_torque_nm": resolved<f64-bits>,
  "gears": [* forward-gear-spec]
}

forward-gear-spec = {
  "id": stable-id,
  "authored_ordinal": resolved<u32>,
  "semantic_id": resolved<tstr>,
  "ratio": resolved<f64-bits>
}

gear-selection-point-array = [* gear-selection-point]

gear-selection-point = {
  "event_id": tstr,
  "time_s": f64-bits,
  "gear_id": stable-id / null
}

scalar-control-point-array = [* scalar-control-point]

scalar-control-point = {
  "event_id": tstr,
  "time_s": f64-bits,
  "value": f64-bits
}

brake-torque-point = {
  "angular_speed_rad_s": f64-bits,
  "resisting_torque_nm": f64-bits
}

rpm-trajectory = {
  "rpm": rpm-trajectory-value,
  "initial_theta_rad": resolved<f64-bits>,
  "kinematic_resolution": resolved<method-identity>
}

rpm-trajectory-value =
  {
    "kind": "scalar_trajectory",
    "value": scalar-trajectory
  } /
  {
    "kind": "fixed_rate_rpm",
    "value": fixed-rate-rpm-trajectory
  }

fixed-rate-rpm-trajectory = {
  "rate": rational-rate-hz,
  "first_step_index": u64-hex,
  "semantics": "post_step_rpm",
  "sample_count": u64-hex,
  "samples_f64le_sha256": sha256,
  "resolution_id": tstr
}

scalar-trajectory = {
  "interpolation": trajectory-interpolation,
  "points": [* scalar-trajectory-point],
  "resolution_id": tstr
}

scalar-trajectory-point = {
  "time_s": f64-bits,
  "value": f64-bits
}

provenance-bundle-ref = {
  "id": tstr,
  "sha256": sha256
}

determinism-envelope = {
  "build": build-identity,
  "numeric_policy_id": "x86-64-v1-binary64-x87-extended-strict-v1",
  "instruction_set_profile": "x86-64-v1",
  "floating_point": floating-point-identity,
  "deterministic_worker_count": 1,
  "deterministic_reduction_topology": "serial-stable-order"
}

build-identity = {
  "git_commit_id": tstr,
  "source_closure_sha256": sha256,
  "compiler_id": tstr,
  "compiler_version": tstr,
  "target_triple": tstr,
  "standard_library_id": "libstdcxx",
  "standard_library_identity": tstr,
  "math_library_id": "glibc-libm",
  "math_library_identity": tstr,
  "compiler_runtime_id": "libgcc-s",
  "compiler_runtime_identity": tstr
}

floating-point-identity = {
  "format": "ieee754_binary64",
  "rounding": "nearest_ties_to_even",
  "fma_contraction": false,
  "flush_to_zero": false,
  "denormals_are_zero": false
}

render-rates = {
  "physics": rational-rate-hz,
  "capture": rational-rate-hz,
  "source_processing": rational-rate-hz,
  "acoustic": rational-rate-hz,
  "delivery": rational-rate-hz
}

rational-rate-hz = {
  "numerator": u64-hex,
  "denominator": u64-hex
}

method-identity = {
  "id": tstr,
  "version": u32,
  "configuration_sha256": sha256
}

random-plan = {
  "generator": method-identity,
  "public_seed": u64-hex,
  "derivation": method-identity,
  "component_seeds": [* component-seed]
}

component-seed = {
  "kind": random-component-kind,
  "cylinder_id": stable-id / null,
  "route_id": stable-id / null,
  "initial_state": u64-hex,
  "stream": u64-hex
}

output-contract = {
  "source_matrix_id": tstr,
  "source_matrix_sha256": sha256,
  "distribution": distribution-intent,
  "required_source_routes": [* source-route-requirement],
  "required_output_buses": [* output-bus-requirement],
  "required_artifacts": [* artifact-requirement],
  "declared_omissions": [* declared-omission]
}

source-route-requirement = {
  "semantic_id": tstr,
  "kind": source-route-kind,
  "disposition": route-disposition,
  "disposition_reason": tstr,
  "artifact_roles": [* tstr]
}

output-bus-requirement = {
  "semantic_id": tstr,
  "kind": output-bus-kind,
  "artifact_roles": [* tstr]
}

artifact-requirement = {
  "role": tstr,
  "kind": artifact-kind,
  "audio": audio-contract / null,
  "diagnostic": bool
}

declared-omission = {
  "semantic_id": tstr,
  "kind": omission-kind,
  "rationale": tstr
}

audio-contract = {
  "sample_rate": rational-rate-hz,
  "frame_count": u64-hex,
  "channel_layout_id": tstr,
  "sample_encoding_id": tstr
}

route-record = {
  "route_id": stable-id,
  "semantic_id": tstr,
  "kind": source-route-kind,
  "disposition": route-disposition,
  "disposition_reason": tstr,
  "artifact_roles": [* tstr]
}

output-bus-record = {
  "semantic_id": tstr,
  "kind": output-bus-kind,
  "artifact_roles": [* tstr]
}

artifact-record = {
  "role": tstr,
  "kind": artifact-kind,
  "relative_path": tstr,
  "audio": audio-contract / null,
  "byte_count": u64-hex,
  "payload_sha256": sha256,
  "diagnostic": bool
}

execution-facts = {
  "run_id": tstr,
  "started_utc": tstr,
  "wall_elapsed_ns": i64-nanoseconds,
  "host_os": tstr,
  "cpu_model": tstr,
  "logical_cpu_count": u32,
  "observed_process_threads": u32,
  "concurrent_render_jobs": u32,
  "peak_resident_bytes": u64-hex / null
}

resolved<t> = {
  "value": t,
  "resolution_id": tstr
}

cylinder-id-array = [* stable-id]
route-id-array = [* stable-id]

; StableId<T> is a direct native JSON u32, not an object with a value member.
stable-id = u32
u32 = 0..4294967295
sha256 = tstr .regexp "[0-9a-f]{64}"
u64-hex = tstr .regexp "0x[0-9a-f]{16}"
torque-term-mask = u64-hex
availability = "available" / "unavailable"
completeness = "complete" / "incomplete"
f64-bits = tstr .regexp "0x[0-9a-f]{16}"
i64-nanoseconds = tstr .regexp "(0|-?[1-9][0-9]*)"

engine-cycle = "four_stroke"
ignition-kind = "spark_ignition"
cylinder-layout-kind = "inline_engine" / "vee_engine" / "flat_engine" / "other"
port-kind = "intake" / "exhaust"
gas-volume-kind =
  "atmosphere" /
  "intake_plenum" /
  "intake_runner" /
  "cylinder" /
  "exhaust_primary" /
  "exhaust_collector"
legacy-restriction-calibration = "carb_at_1p5_inhg" / "cfm_at_28_inh2o"
trajectory-interpolation = "right_continuous_hold" / "linear"

random-component-kind =
  "combustion" /
  "presentation_jitter" /
  "presentation_air_noise" /
  "starter"

source-route-kind =
  "exhaust_outlet" /
  "intake_inlet" /
  "mechanical_engine" /
  "mechanical_starter"

audio-sample-encoding = "pcm_s16le" / "float32le" / "pcm_s24le"
audio-channel-layout = "mono"
artifact-kind = "audio" / "telemetry" / "routing_report" / "validation_report"
distribution-intent = "local_evaluation" / "distributable"
output-bus-kind =
  "master_engine_raw" /
  "master_engine_audition"
route-disposition = "rendered" / "not_applicable"
omission-kind =
  "source_route" /
  "external_system" /
  "presentation_scene" /
  "scenario_behavior"
