+
+void PistonEngineSimulator::initializeReferenceAuditCapture() {
+    if (m_referenceAuditInitialized) return;
+    m_referenceAuditInitialized = true;
+
+    const std::string parityPartial =
+        referenceAuditPath("reference-parity.bin.partial");
+    if (parityPartial.empty()) return;
+
+    if (m_engine == nullptr
+        || m_engine->getName() != "BMW M52B28"
+        || m_engine->getCylinderCount() != 6
+        || m_engine->getExhaustSystemCount() != 2
+        || getSimulationFrequency() != 10000
+        || getDeliverySampleRateHz() != 192000) {
+        throw std::runtime_error(
+            "P1.8 reference capture requires the canonical BMW M52B28 "
+            "6-cylinder, 2-route, 10 kHz / 192 kHz runtime");
+    }
+    if (!std::numeric_limits<double>::is_iec559) {
+        throw std::runtime_error(
+            "P1.8 reference capture requires IEC 60559 binary64");
+    }
+    if (std::fegetround() != FE_TONEAREST) {
+        throw std::runtime_error(
+            "P1.8 reference capture requires round-to-nearest");
+    }
+
+    const std::string auditPartial =
+        referenceAuditPath("reference-audit.bin.partial");
+    const std::string parityFinal =
+        referenceAuditPath("reference-parity.bin");
+    const std::string auditFinal =
+        referenceAuditPath("reference-audit.bin");
+    requireReferencePathAbsent(parityPartial);
+    requireReferencePathAbsent(auditPartial);
+    requireReferencePathAbsent(parityFinal);
+    requireReferencePathAbsent(auditFinal);
+
+    m_referenceParityFile =
+        std::fopen(parityPartial.c_str(), "wb");
+    m_referenceAuditFile =
+        std::fopen(auditPartial.c_str(), "wb");
+    if (m_referenceParityFile == nullptr
+        || m_referenceAuditFile == nullptr) {
+        if (m_referenceParityFile != nullptr) {
+            std::fclose(m_referenceParityFile);
+            m_referenceParityFile = nullptr;
+        }
+        if (m_referenceAuditFile != nullptr) {
+            std::fclose(m_referenceAuditFile);
+            m_referenceAuditFile = nullptr;
+        }
+        throw std::runtime_error(
+            "Could not open the P1.8 reference fixture output files");
+    }
+
+    const uint32_t cylinderCount =
+        static_cast<uint32_t>(m_engine->getCylinderCount());
+    const uint32_t exhaustCount =
+        static_cast<uint32_t>(m_engine->getExhaustSystemCount());
+    const uint32_t parityHeaderBytes =
+        128u + 80u * cylinderCount;
+    const uint32_t parityRecordBytes =
+        80u + 24u * cylinderCount;
+    const uint32_t auditRecordBytes =
+        16u + 16u * cylinderCount + 8u * exhaustCount;
+
+    try {
+        writeReferenceBytes(
+            m_referenceParityFile,
+            "ESOPAR01",
+            8);
+        writeReferenceLe32(m_referenceParityFile, 1);
+        writeReferenceLe32(
+            m_referenceParityFile,
+            parityHeaderBytes);
+        writeReferenceLe32(
+            m_referenceParityFile,
+            cylinderCount);
+        writeReferenceLe32(
+            m_referenceParityFile,
+            exhaustCount);
+        writeReferenceLe32(
+            m_referenceParityFile,
+            parityRecordBytes);
+        writeReferenceLe32(
+            m_referenceParityFile,
+            getSimulationFrequency());
+        writeReferenceLe64(m_referenceParityFile, 0);
+        writeReferenceLe64(
+            m_referenceParityFile,
+            ReferenceAuditAudibleStart);
+        writeReferenceLe64(
+            m_referenceParityFile,
+            ReferenceAuditExpectedRecords);
+        writeReferenceLeDouble(
+            m_referenceParityFile,
+            units::pressure(1.0, units::atm));
+        writeReferenceLeDouble(m_referenceParityFile, 343.0);
+        writeReferenceLeDouble(m_referenceParityFile, 1600.0);
+        writeReferenceLeDouble(m_referenceParityFile, 40.0);
+        writeReferenceLeDouble(m_referenceParityFile, 1.0);
+        writeReferenceLeDouble(m_referenceParityFile, 0.1);
+        writeReferenceLeDouble(m_referenceParityFile, 0.1);
+        writeReferenceLeDouble(
+            m_referenceParityFile,
+            static_cast<double>(cylinderCount));
+        writeReferenceLeDouble(m_referenceParityFile, 2.0);
+
+        const IgnitionModule *ignition =
+            m_engine->getIgnitionModule();
+        for (uint32_t i = 0; i < cylinderCount; ++i) {
+            Piston *piston =
+                m_engine->getPiston(static_cast<int>(i));
+            CylinderBank *bank =
+                piston->getCylinderBank();
+            CylinderHead *head =
+                m_engine->getHead(bank->getIndex());
+            const int cylinderIndex =
+                piston->getCylinderIndex();
+            ExhaustSystem *exhaust =
+                head->getExhaustSystem(cylinderIndex);
+            const double firingAngle =
+                ignition->referenceAuditFiringAngle(
+                    static_cast<int>(i));
+            uint32_t firingRank = 0;
+            for (uint32_t j = 0; j < cylinderCount; ++j) {
+                const double other =
+                    ignition->referenceAuditFiringAngle(
+                        static_cast<int>(j));
+                if (other < firingAngle
+                    || (other == firingAngle && j < i)) {
+                    ++firingRank;
+                }
+            }
+            const double headerLength =
+                head->getHeaderPrimaryLength(cylinderIndex);
+            const double exhaustLength =
+                exhaust->getLength();
+
+            writeReferenceLe32(m_referenceParityFile, i);
+            writeReferenceLe32(m_referenceParityFile, i + 1u);
+            writeReferenceLe32(
+                m_referenceParityFile,
+                firingRank);
+            writeReferenceLe32(
+                m_referenceParityFile,
+                static_cast<uint32_t>(exhaust->getIndex()));
+            writeReferenceLe32(
+                m_referenceParityFile,
+                static_cast<uint32_t>(
+                    m_delayFilters[i]
+                        .referenceAuditLatencySamples()));
+            writeReferenceLe32(m_referenceParityFile, 0);
+            writeReferenceLeDouble(
+                m_referenceParityFile,
+                firingAngle);
+            writeReferenceLeDouble(
+                m_referenceParityFile,
+                headerLength);
+            writeReferenceLeDouble(
+                m_referenceParityFile,
+                exhaustLength);
+            writeReferenceLeDouble(
+                m_referenceParityFile,
+                headerLength + exhaustLength);
+            writeReferenceLeDouble(
+                m_referenceParityFile,
+                exhaust->getPrimaryTubeLength());
+            writeReferenceLeDouble(
+                m_referenceParityFile,
+                head->getSoundAttenuation(cylinderIndex));
+            writeReferenceLeDouble(
+                m_referenceParityFile,
+                exhaust->getAudioVolume());
+        }
+
+        writeReferenceBytes(
+            m_referenceAuditFile,
+            "ESOAUD01",
+            8);
+        writeReferenceLe32(m_referenceAuditFile, 1);
+        writeReferenceLe32(m_referenceAuditFile, 64);
+        writeReferenceLe32(
+            m_referenceAuditFile,
+            cylinderCount);
+        writeReferenceLe32(
+            m_referenceAuditFile,
+            exhaustCount);
+        writeReferenceLe32(
+            m_referenceAuditFile,
+            auditRecordBytes);
+        writeReferenceLe32(
+            m_referenceAuditFile,
+            getSimulationFrequency());
+        writeReferenceLe64(m_referenceAuditFile, 0);
+        writeReferenceLe64(m_referenceAuditFile, 0);
+        writeReferenceLe64(
+            m_referenceAuditFile,
+            ReferenceAuditExpectedRecords);
+        writeReferenceLe64(m_referenceAuditFile, 0);
+    }
+    catch (...) {
+        std::fclose(m_referenceParityFile);
+        std::fclose(m_referenceAuditFile);
+        m_referenceParityFile = nullptr;
+        m_referenceAuditFile = nullptr;
+        throw;
+    }
+
+    m_referencePreDelay = new double[cylinderCount];
+    m_referencePostDelay = new double[cylinderCount];
+    m_referenceAuditRecords = 0;
+    m_referenceAuditElapsedSeconds = 0.0;
+
+    std::fprintf(
+        stderr,
+        "[REFERENCE AUDIT] P1.8 fixture -> %s\n",
+        referenceAuditPath("").c_str());
+}
+
+void PistonEngineSimulator::writeReferenceAuditCapture() {
+    if (m_referenceParityFile == nullptr
+        || m_referenceAuditFile == nullptr) {
+        return;
+    }
+    if (m_referenceAuditRecords
+        >= ReferenceAuditExpectedRecords) {
+        throw std::runtime_error(
+            "P1.8 reference fixture received too many records");
+    }
+
+    const uint64_t sampleIndex =
+        m_referenceAuditRecords;
+    const uint64_t stepEnd =
+        sampleIndex + 1;
+    const double timestep = getTimestep();
+    m_referenceAuditElapsedSeconds += timestep;
+
+    writeReferenceLe64(
+        m_referenceParityFile,
+        sampleIndex);
+    writeReferenceLe64(
+        m_referenceParityFile,
+        stepEnd);
+    writeReferenceLeDouble(
+        m_referenceParityFile,
+        m_referenceAuditElapsedSeconds);
+    writeReferenceLeDouble(
+        m_referenceParityFile,
+        timestep);
+    writeReferenceLeDouble(
+        m_referenceParityFile,
+        m_engine->getRpm());
+    writeReferenceLeDouble(
+        m_referenceParityFile,
+        filteredEngineSpeed());
+    writeReferenceLeDouble(
+        m_referenceParityFile,
+        m_engine->getOutputCrankshaft()
+            ->getCycleAngle());
+    writeReferenceLeDouble(
+        m_referenceParityFile,
+        m_engine->getSpeedControl());
+    writeReferenceLeDouble(
+        m_referenceParityFile,
+        m_engine->getThrottle());
+    writeReferenceU8(
+        m_referenceParityFile,
+        m_engine->getIgnitionModule()->m_enabled
+            ? 1u
+            : 0u);
+    writeReferenceU8(
+        m_referenceParityFile,
+        m_engine->isFuelDeliveryEnabled()
+            ? 1u
+            : 0u);
+    writeReferenceU8(
+        m_referenceParityFile,
+        m_starterMotor.m_enabled
+            ? 1u
+            : 0u);
+    writeReferenceU8(
+        m_referenceParityFile,
+        m_dyno.m_enabled
+            ? 1u
+            : 0u);
+    writeReferenceLe32(m_referenceParityFile, 0);
+
+    const int cylinderCount =
+        m_engine->getCylinderCount();
+    for (int i = 0; i < cylinderCount; ++i) {
+        CombustionChamber *chamber =
+            m_engine->getChamber(i);
+        writeReferenceLeDouble(
+            m_referenceParityFile,
+            chamber->m_exhaustRunnerAndPrimary
+                .pressure());
+        writeReferenceLeDouble(
+            m_referenceParityFile,
+            chamber->m_exhaustRunnerAndPrimary
+                .dynamicPressure(1.0, 0.0));
+        writeReferenceLeDouble(
+            m_referenceParityFile,
+            chamber->m_exhaustRunnerAndPrimary
+                .dynamicPressure(-1.0, 0.0));
+    }
+
+    writeReferenceLe64(
+        m_referenceAuditFile,
+        sampleIndex);
+    writeReferenceLe64(
+        m_referenceAuditFile,
+        stepEnd);
+    for (int i = 0; i < cylinderCount; ++i) {
+        writeReferenceLeDouble(
+            m_referenceAuditFile,
+            m_referencePreDelay[i]);
+    }
+    for (int i = 0; i < cylinderCount; ++i) {
+        writeReferenceLeDouble(
+            m_referenceAuditFile,
+            m_referencePostDelay[i]);
+    }
+    for (int i = 0;
+        i < m_engine->getExhaustSystemCount();
+        ++i) {
+        writeReferenceLeDouble(
+            m_referenceAuditFile,
+            m_exhaustFlowStagingBuffer[i]);
+    }
+
+    ++m_referenceAuditRecords;
+    if (m_referenceAuditRecords
+        == ReferenceAuditExpectedRecords) {
+        finalizeReferenceAuditCapture(true);
+    }
+}
+
+void PistonEngineSimulator::finalizeReferenceAuditCapture(
+    bool requireComplete)
+{
+    if (m_referenceParityFile == nullptr
+        && m_referenceAuditFile == nullptr) {
+        delete[] m_referencePreDelay;
+        delete[] m_referencePostDelay;
+        m_referencePreDelay = nullptr;
+        m_referencePostDelay = nullptr;
+        return;
+    }
+
+    const bool complete =
+        m_referenceAuditRecords
+        == ReferenceAuditExpectedRecords;
+    bool succeeded = true;
+    if (requireComplete && !complete) {
+        succeeded = false;
+    }
+
+    if (complete) {
+        for (FILE *file : {
+            m_referenceParityFile,
+            m_referenceAuditFile,
+        }) {
+            if (file == nullptr
+                || std::fseek(file, 32, SEEK_SET) != 0) {
+                succeeded = false;
+                continue;
+            }
+            try {
+                writeReferenceLe64(
+                    file,
+                    m_referenceAuditRecords);
+            }
+            catch (...) {
+                succeeded = false;
+            }
+        }
+    }
+
+    for (FILE **file : {
+        &m_referenceParityFile,
+        &m_referenceAuditFile,
+    }) {
+        if (*file != nullptr) {
+            if (std::fflush(*file) != 0) {
+                succeeded = false;
+            }
+            if (std::fclose(*file) != 0) {
+                succeeded = false;
+            }
+            *file = nullptr;
+        }
+    }
+
+    delete[] m_referencePreDelay;
+    delete[] m_referencePostDelay;
+    m_referencePreDelay = nullptr;
+    m_referencePostDelay = nullptr;
+
+    if (!complete) {
+        std::fprintf(
+            stderr,
+            "[REFERENCE AUDIT] Incomplete fixture retained as .partial "
+            "(%llu/%llu records)\n",
+            static_cast<unsigned long long>(
+                m_referenceAuditRecords),
+            static_cast<unsigned long long>(
+                ReferenceAuditExpectedRecords));
+        if (requireComplete) {
+            throw std::runtime_error(
+                "P1.8 reference fixture ended before its required "
+                "record count");
+        }
+        return;
+    }
+    if (!succeeded) {
+        throw std::runtime_error(
+            "Could not finalize the P1.8 reference fixture");
+    }
+
+    const std::string parityPartial =
+        referenceAuditPath("reference-parity.bin.partial");
+    const std::string auditPartial =
+        referenceAuditPath("reference-audit.bin.partial");
+    const std::string parityFinal =
+        referenceAuditPath("reference-parity.bin");
+    const std::string auditFinal =
+        referenceAuditPath("reference-audit.bin");
+    if (std::rename(
+            parityPartial.c_str(),
+            parityFinal.c_str()) != 0
+        || std::rename(
+            auditPartial.c_str(),
+            auditFinal.c_str()) != 0) {
+        throw std::runtime_error(
+            "Could not publish the complete P1.8 reference fixture");
+    }
+
+    std::fprintf(
+        stderr,
+        "[REFERENCE AUDIT] Finalized %llu paired records\n",
+        static_cast<unsigned long long>(
+            m_referenceAuditRecords));
+}
