; Canonical JSON shape for a completed simulation RenderManifest.
; Map-member order is serialization order. Semantic validation is additionally
; required; in particular f64-bits must decode to a finite binary64 value and
; both binary64 zero signs use the canonical positive-zero representation.
;
; The fixed-rate RPM vector is deliberately represented by sample_count and
; samples_f64le_sha256. Before encoding, the encoder must recompute that digest
; from the complete owned binary64 vector using the typed contract's canonical
; little-endian grammar.

render-manifest-simulation-v10 = {
  "wire_schema": "engine-sim-offline.render-manifest.simulation.v10",
  "content": render-manifest-content-simulation-v10,
  "execution": execution-facts
}

; Canonical identity for a resolved simulator request before presentation/render
; composition. This domain is intentionally distinct from the completed manifest.
simulation-request-identity-v7 = {
  "wire_schema": "engine-sim-offline.simulation-request-identity.v7",
  "engine": engine-spec,
  "scenario": render-scenario,
  "random_plan": random-plan,
  "provenance": provenance-bundle-ref
}

render-manifest-content-simulation-v10 = {
  "schema_version": 10,
  "inputs": simulation-manifest-inputs-v9,
  "provenance": provenance-bundle-ref,
  "determinism": determinism-envelope,
  "rates": render-rates,
  "randomness": random-plan,
  "output_contract": output-contract,
  "routes": [* route-record],
  "output_buses": [* output-bus-record],
  "artifacts": [* artifact-record]
}

simulation-manifest-inputs-v9 = {
  "kind": "simulation_v9",
  "value": simulation-inputs-v9
}

simulation-inputs-v9 = {
  "resolved": resolved-render-inputs
}

resolved-render-inputs = {
  "engine": engine-spec,
  "presentation": presentation-calibration,
  "randomness": resolved-randomness-policy,
  "scenario": render-scenario
}

resolved-randomness-policy = {
  "seed_namespace_id": resolved<tstr>,
  "generator": resolved<method-identity>,
  "derivation": resolved<method-identity>
}

engine-spec = {
  "schema_version": u32,
  "id": stable-id,
  "engine_id": resolved<tstr>,
  "profile_id": resolved<tstr>,
  "display_name": resolved<tstr>,
  "cycle": resolved<engine-cycle>,
  "ignition": resolved<ignition-kind>,
  "cylinder_layout": resolved<cylinder-layout-kind>,
  "total_displacement_m3": resolved<f64-bits>,
  "crankshafts": [* crankshaft-spec],
  "output_crankshaft_id": stable-id,
  "banks": [* bank-spec],
  "intakes": [* intake-spec],
  "cylinders": [* cylinder-spec],
  "ports": [* port-spec],
  "gas_volumes": [* gas-volume-spec],
  "flow_edges": [* flow-edge-spec],
  "routes": [* route-spec],
  "methods": engine-model-methods,
  "physics_profile": executable-physics-profile,
  "torque_capability": resolved<torque-capability>,
  "provenance_schema_id": tstr
}

crankshaft-spec = {
  "id": stable-id,
  "semantic_id": resolved<tstr>
}

bank-spec = {
  "id": stable-id,
  "semantic_id": resolved<tstr>,
  ? "angle_rad": resolved<f64-bits>
}

intake-spec = {
