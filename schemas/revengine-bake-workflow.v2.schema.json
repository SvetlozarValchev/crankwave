{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engine-sim-offline.dev/schemas/revengine-bake-workflow.v2.schema.json",
  "title": "Engine Sim Offline native REVENGINE bake workflow v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "release_identity",
    "path_base",
    "production_runtime",
    "responsive_profile_selection",
    "telemetry_contract",
    "placeholders",
    "steps",
    "success"
  ],
  "properties": {
    "schema": {"const": "engine-sim-offline/revengine-bake-workflow.v2"},
    "release_identity": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z][0-9A-Za-z.+-]*)?$"
    },
    "path_base": {"const": "distribution_root"},
    "production_runtime": {
      "const": {
        "kind": "native",
        "node_required": false,
        "simulation_wasm_required": false
      }
    },
    "responsive_profile_selection": {
      "const": {
        "default_policy": "engine-redline-affine-v1",
        "profile_id": "interactive-preview-redline-v1",
        "explicit_override": null
      }
    },
    "telemetry_contract": {
      "const": {
        "producer_command": "render",
        "role": "diagnostics.engine-telemetry.v1",
        "kind": "telemetry",
        "path": "telemetry/engine-telemetry.v1.ndjson",
        "schema": "engine-sim-offline.engine-telemetry.ndjson.v1",
        "originating_commit": "c8d672b59e3046654ad5f818f31725798aef7ffa",
        "included_in_revengine_workflow": false
      }
    },
    "placeholders": {
      "const": {
        "engine_json": "absolute path to the admitted engine document",
        "deadline_unix_ms": "positive Unix epoch deadline in milliseconds",
        "new_revengine_file": "absolute .revengine path that does not exist"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"$ref": "#/$defs/nativeBakeStep"}
    },
    "success": {
      "const": {
        "definition": "the single native step exits zero after full carrier verification",
        "publishable_after_step": 1
      }
    }
  },
  "$defs": {
    "nativeBakeStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "id",
        "executable",
        "arguments",
        "required_output",
        "required_stdout_record",
        "required_result_fields"
      ],
      "properties": {
        "ordinal": {"const": 1},
        "id": {"const": "bake_revengine"},
        "executable": {"type": "string", "pattern": "^[A-Za-z0-9._+/@-]+$"},
        "arguments": {
          "const": [
            "bake-revengine",
            "--engine",
            "{engine_json}",
            "--output",
            "{new_revengine_file}",
            "--deadline-unix-ms",
            "{deadline_unix_ms}",
            "--result-format",
            "json"
          ]
        },
        "required_output": {"const": "{new_revengine_file}"},
        "required_stdout_record": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "release_identity", "command", "ok", "code", "exit_code"],
          "properties": {
            "schema": {"const": "engine-sim-offline.cli-result.v1"},
            "release_identity": {"type": "string"},
            "command": {"const": "bake-revengine"},
            "ok": {"const": true},
            "code": {"const": "success"},
            "exit_code": {"const": 0}
          }
        },
        "required_result_fields": {
          "const": {"output_file": "{new_revengine_file}", "verified": true}
        }
      }
    }
  }
}
