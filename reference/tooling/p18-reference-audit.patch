+
+void writeReferenceSeedInventory(
+    const engine_sim_random::ComponentSeeds &seeds)
+{
+    const char *directory =
+        std::getenv("ENGINE_SIM_OFFLINE_REFERENCE_FIXTURE_DIR");
+    if (directory == nullptr || directory[0] == '\0') return;
+
+    const fs::path root =
+        fs::absolute(fs::path(directory)).lexically_normal();
+    std::error_code directoryError;
+    fs::create_directories(root, directoryError);
+    if (directoryError
+        || !fs::is_directory(root)) {
+        fail(
+            "Could not create P1.8 reference fixture directory "
+            + root.string());
+    }
+    const fs::path partial =
+        root / "component-seeds.bin.partial";
+    const fs::path output =
+        root / "component-seeds.bin";
+    if (fs::exists(partial) || fs::exists(output)) {
+        fail(
+            "Refusing to overwrite an existing P1.8 reference seed "
+            "inventory");
+    }
+
+    std::ofstream out(
+        partial,
+        std::ios::binary | std::ios::trunc);
+    if (!out) {
+        fail(
+            "Could not open P1.8 reference seed inventory "
+            + partial.string());
+    }
+    out.write("ESOSEED1", 8);
+    writeLe32(out, 1);
+    writeLe32(
+        out,
+        static_cast<uint32_t>(
+            seeds.combustion.size()));
+    writeLe32(
+        out,
+        static_cast<uint32_t>(
+            seeds.synthAirNoise.size()));
+    writeLe32(out, 16);
+    writeLe32(
+        out,
+        static_cast<uint32_t>(
+            seeds.combustion.size()));
+    writeLe32(
+        out,
+        static_cast<uint32_t>(
+            seeds.synthAirNoise.size()));
+    writeLe32(
+        out,
+        static_cast<uint32_t>(
+            seeds.synthJitter.size()));
+    writeLe32(out, 0);
+    const auto writeSeed =
+        [&out](const engine_sim_random::Pcg32Seed &seed) {
+            writeLe64(out, seed.initialState);
+            writeLe64(out, seed.stream);
+        };
+    for (const auto &seed : seeds.combustion) {
+        writeSeed(seed);
+    }
+    for (const auto &seed : seeds.synthAirNoise) {
+        writeSeed(seed);
+    }
+    for (const auto &seed : seeds.synthJitter) {
+        writeSeed(seed);
+    }
+    writeSeed(seeds.starter);
+    out.close();
+    if (!out) {
+        fail(
+            "Could not finish P1.8 reference seed inventory "
+            + partial.string());
+    }
+    fs::rename(partial, output, directoryError);
+    if (directoryError) {
+        fail(
+            "Could not publish P1.8 reference seed inventory "
+            + output.string()
+            + ": "
+            + directoryError.message());
+    }
+}
