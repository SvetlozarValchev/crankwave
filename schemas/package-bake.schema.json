{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engine-sim-offline.dev/schemas/package-bake.schema.json",
  "title": "Engine Sim Offline responsive package-bake document",
  "$comment": "This is the single current package-bake authoring contract. Reference resolution and strict load-plane ordering are also checked by the product parser.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "engine",
    "public_seed",
    "audio",
    "scenario_sources",
    "running",
    "events"
  ],
  "properties": {
    "schema": { "const": "engine-sim-offline/package-bake" },
    "id": { "$ref": "#/$defs/id" },
    "engine": { "$ref": "#/$defs/id" },
    "public_seed": { "$ref": "#/$defs/uint64Decimal" },
    "audio": { "$ref": "#/$defs/audio" },
    "scenario_sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenarioSource" }
    },
    "running": { "$ref": "#/$defs/running" },
    "events": {
      "type": "array",
      "maxItems": 0
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "uint64Decimal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "rationalRate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator", "unit"],
      "properties": {
        "numerator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "denominator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[1-9][0-9]{0,19}$"
        },
        "unit": { "const": "Hz" }
      }
    },
    "rpmQuantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "enum": ["rpm", "rad/s"] }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_rate", "buses"],
      "properties": {
        "sample_rate": { "$ref": "#/$defs/rationalRate" },
        "buses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "scenarioSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "uri"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "rpmRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": { "$ref": "#/$defs/rpmQuantity" },
        "maximum": { "$ref": "#/$defs/rpmQuantity" }
      }
    },
    "runningPlane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "load_coordinate", "direction", "scenario"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "load_coordinate": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "direction": { "enum": ["rising", "falling"] },
        "scenario": { "$ref": "#/$defs/id" }
      }
    },
    "running": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rpm_range", "planes", "idle"],
      "properties": {
        "rpm_range": { "$ref": "#/$defs/rpmRange" },
        "planes": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/runningPlane" },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": ["load_coordinate"],
                "properties": { "load_coordinate": { "const": -1 } }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["load_coordinate"],
                "properties": { "load_coordinate": { "const": 1 } }
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "idle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scenario"],
          "properties": {
            "scenario": { "$ref": "#/$defs/id" }
          }
        }
      }
    }
  }
}
