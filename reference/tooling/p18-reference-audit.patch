+
+constexpr uint64_t ReferenceAuditExpectedRecords = UINT64_C(170000);
+constexpr uint64_t ReferenceAuditAudibleStart = UINT64_C(20000);
+
+void writeReferenceBytes(
+    FILE *file,
+    const void *data,
+    std::size_t size)
+{
+    if (std::fwrite(data, 1, size, file) != size) {
+        throw std::runtime_error(
+            "Could not write the P1.8 reference fixture");
+    }
+}
+
+void writeReferenceU8(FILE *file, uint8_t value) {
+    writeReferenceBytes(file, &value, sizeof(value));
+}
+
+void writeReferenceLe32(FILE *file, uint32_t value) {
+    const unsigned char bytes[4] = {
+        static_cast<unsigned char>(value & 0xffu),
+        static_cast<unsigned char>((value >> 8) & 0xffu),
+        static_cast<unsigned char>((value >> 16) & 0xffu),
+        static_cast<unsigned char>((value >> 24) & 0xffu)
+    };
+    writeReferenceBytes(file, bytes, sizeof(bytes));
+}
+
+void writeReferenceLe64(FILE *file, uint64_t value) {
+    unsigned char bytes[8];
+    for (int i = 0; i < 8; ++i) {
+        bytes[i] = static_cast<unsigned char>(
+            (value >> (i * 8)) & UINT64_C(0xff));
+    }
+    writeReferenceBytes(file, bytes, sizeof(bytes));
+}
+
+void writeReferenceLeDouble(FILE *file, double value) {
+    static_assert(
+        sizeof(double) == sizeof(uint64_t),
+        "P1.8 reference fixtures require binary64");
+    uint64_t bits = 0;
+    std::memcpy(&bits, &value, sizeof(bits));
+    writeReferenceLe64(file, bits);
+}
+
+std::string referenceAuditPath(const char *filename) {
+    const char *directory =
+        std::getenv("ENGINE_SIM_OFFLINE_REFERENCE_FIXTURE_DIR");
+    if (directory == nullptr || directory[0] == '\0') {
+        return {};
+    }
+    std::string path(directory);
+    if (path.back() != '/' && path.back() != '\\') {
+        path.push_back('/');
+    }
+    path += filename;
+    return path;
+}
+
+void requireReferencePathAbsent(const std::string &path) {
+    FILE *existing = std::fopen(path.c_str(), "rb");
+    if (existing != nullptr) {
+        std::fclose(existing);
+        throw std::runtime_error(
+            "Refusing to overwrite existing P1.8 reference fixture file: "
+            + path);
+    }
+}
+
+#endif
+
 } // namespace
 
